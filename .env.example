# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local or any other env file (they are git-ignored).

# --- Public (safe in the browser; protected by Row Level Security) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Server only (never prefix with NEXT_PUBLIC_) ---
# Supabase secret key (sb_secret_...). Needed from M2 for user management only.
SUPABASE_SECRET_KEY=
# Protects the PDF retry cron route (M6). Random 32+ characters.
CRON_SECRET=
# Business time zone. Do not change.
APP_TIMEZONE=Asia/Kolkata
