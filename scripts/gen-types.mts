/**
 * Regenerates src/lib/supabase/database.types.ts from the migrations.
 *
 *   1. start a THROW-AWAY PostgreSQL 17 (never Supabase) and point STATEADV_PG_URL at it
 *   2. STATEADV_PG_RESTRICTED=1 STATEADV_PG_URL=... npx tsx scripts/gen-types.mts
 *   3. npm run format
 *
 * It builds a scratch database from supabase/migrations/*.sql exactly like the tests do, asks the Supabase CLI for the
 * types of schema "public", and writes them with a "generated, do not edit" header. Nothing is sent to Supabase.
 * tests/db/types-in-sync.test.ts fails when the committed file and the migrations disagree.
 */
import { spawnSync } from "node:child_process";
import { writeFileSync } from "node:fs";
import { createDb } from "../tests/db/harness";

const OUT = "src/lib/supabase/database.types.ts";
const HEADER = `/**
 * GENERATED FILE - do not edit by hand.
 * Types of the StateAdv database (schema "public"), generated by "supabase gen types" from a throw-away database built from
 * supabase/migrations/*.sql. Regenerate after any migration: see README, "Regenerating the database types".
 * A test (tests/db/types-in-sync.test.ts) fails if this file and the migrations disagree.
 */
`;

if (!process.env.STATEADV_PG_URL) {
  console.error(
    "Set STATEADV_PG_URL to a throw-away local PostgreSQL (never a Supabase address). See README.",
  );
  process.exit(1);
}
const db = await createDb();
if (
  !db.url ||
  !/^postgres(ql)?:\/\/[^/]*@(localhost|127\.0\.0\.1)[:/]/.test(db.url)
) {
  console.error("Refusing: the database must be a local throw-away server.");
  process.exit(1);
}
const r = spawnSync(
  process.execPath,
  [
    "node_modules/supabase/dist/supabase.js",
    "gen",
    "types",
    "typescript",
    "--schema",
    "public",
    `--remote=${db.url}`,
  ],
  { encoding: "utf8", env: { ...process.env, NO_COLOR: "1" } },
);
if (r.status !== 0) {
  console.error(
    "Type generation failed:",
    (r.stderr || r.stdout).slice(0, 500),
  );
  process.exit(1);
}
const body = r.stdout.replace(/\x1b\[[0-9;]*m/g, "");
writeFileSync(
  OUT,
  HEADER + body.slice(Math.max(body.indexOf("export type Json"), 0)),
);
console.log(`Wrote ${OUT}. Now run: npm run format`);
process.exit(0);
